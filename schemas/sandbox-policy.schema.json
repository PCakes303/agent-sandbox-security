{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mrcakes931.dev/sandbox-policy/1.0.0",
  "title": "Sandbox Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_version",
    "profile_id",
    "limits",
    "filesystem",
    "network",
    "execution"
  ],
  "properties": {
    "policy_version": {
      "const": "1.0"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_millis",
        "memory_bytes",
        "wall_time_seconds",
        "processes",
        "output_bytes"
      ],
      "properties": {
        "cpu_millis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "memory_bytes": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 17179869184
        },
        "wall_time_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "processes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "output_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 104857600
        }
      }
    },
    "filesystem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_only_root",
        "read_paths",
        "write_paths"
      ],
      "properties": {
        "read_only_root": {
          "const": true
        },
        "read_paths": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^/",
            "not": {
              "anyOf": [
                {
                  "pattern": "(^|/)\\.\\.(?:/|$)"
                },
                {
                  "pattern": "\\u0000"
                }
              ]
            }
          }
        },
        "write_paths": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^/",
            "not": {
              "anyOf": [
                {
                  "pattern": "(^|/)\\.\\.(?:/|$)"
                },
                {
                  "pattern": "\\u0000"
                }
              ]
            }
          }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_deny",
        "egress_allowlist"
      ],
      "properties": {
        "default_deny": {
          "const": true
        },
        "egress_allowlist": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[^\\s\\u0000]+$"
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_execution",
        "require_identity",
        "require_policy",
        "require_stop_state",
        "require_artifact_verification"
      ],
      "properties": {
        "allow_execution": {
          "const": false
        },
        "require_identity": {
          "const": true
        },
        "require_policy": {
          "const": true
        },
        "require_stop_state": {
          "const": true
        },
        "require_artifact_verification": {
          "const": true
        }
      }
    }
  }
}
